TELEGRAM_BOT_TOKEN=123456:replace_me

# LLM provider for /mode quality and /mode hybrid: openai or gemini.
# You can also change it per project in Telegram: /provider openai or /provider gemini.
LLM_PROVIDER=gemini

# Required only if LLM_PROVIDER=openai and you use /mode quality or /mode hybrid.
# Can be empty if you use Gemini or only /mode free.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Required only if LLM_PROVIDER=gemini and you use /mode quality or /mode hybrid.
# Get the key from Google AI Studio.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.1-flash-lite

# Local/self-hosted LibreTranslate. If you use docker-compose from this project,
# keep http://libretranslate:5000 inside Docker. For local Python run, use http://localhost:5000.
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_TIMEOUT_SECONDS=120

# free = LibreTranslate only; quality = selected LLM only; hybrid = LibreTranslate draft + selected LLM editor
DEFAULT_TRANSLATION_MODE=hybrid

DATABASE_PATH=storage/bot.sqlite3
STORAGE_DIR=storage
MAX_DOWNLOAD_MB=18
CHUNK_MAX_CHARS=6500
MAX_PARALLEL_JOBS=2
